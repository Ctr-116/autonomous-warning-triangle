<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>arm_moveit_demo</name>
  <version>2.0.0</version>
  <description>ROS2 Humble MoveIt2 demos for the Yahboom X3plus arm (ported from ROS1 arm_moveit_demo)</description>
  <license>TODO</license>
  <maintainer email="yahboom@todo.todo">yahboom</maintainer>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_core</depend>
  <depend>yahboomcar_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>eigen</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>x3plus_moveit_config</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
