<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>yahboomcar_slam</name>
  <version>0.1.0</version>
  <description>ROS2 Humble native port of the yahboomcar_slam RGB-D pointcloud mapping and optional ORB_SLAM2 tracker wrapper.</description>
  <license>TODO</license>
  <maintainer email="yahboom@todo.todo">yahboom</maintainer>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>cv_bridge</depend>
  <depend>pcl_conversions</depend>
  <build_depend>eigen</build_depend>
  <exec_depend>eigen</exec_depend>
  <build_depend>libopencv-dev</build_depend>
  <exec_depend>libopencv-dev</exec_depend>
  <build_depend>libpcl-all-dev</build_depend>
