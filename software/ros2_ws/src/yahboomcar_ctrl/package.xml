<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>yahboomcar_ctrl</name>
  <version>0.0.0</version>
  <description>
    ROS 2 Humble teleoperation controllers ported from the ROS 1
    yahboomcar_ctrl package: keyboard teleop, PS4/joystick chassis teleop,
    turtlesim joystick demo, and the specialized arm/RGB/buzzer/cancel
    joystick controller. The generic joystick driver is provided by the
    upstream joy_linux package.
  </description>
  <license>TODO</license>
  <maintainer email="yahboom@todo.todo">yahboom</maintainer>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>yahboomcar_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>joy_linux</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
